# 复制为 .env 后填写。线上请填到 GitHub → Settings → Secrets and variables → Actions
SITE_URL=http://localhost:4321
BASE_PATH=/

# 飞书群机器人（默认推送渠道）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 可选：Telegram / 邮件
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# 可选：公众号日报（只存草稿，人工群发）。调用方 IP 要加到公众号后台的 IP 白名单
WECHAT_APPID=
WECHAT_APPSECRET=
# 封面图的永久素材 media_id：第一次运行会自动上传网站分享图，并在日志里打印 media_id，填到这里
WECHAT_THUMB_MEDIA_ID=
WECHAT_AUTHOR=

NOTIFY_CHANNELS=
NOTIFY_ON_SUCCESS=false
ANOMALY_THRESHOLD=0.8
STALE_ALERT_DAYS=3
STALE_WARN_DAYS=7
FX_FALLBACK_RATE=7.1
SOURCES_ENABLED=
DRY_RUN=false
LOG_LEVEL=info

# 可选：访问统计（不使用 Cookie，公开值，放 GitHub Variables 即可）
# cloudflare：ANALYTICS_TOKEN = Cloudflare Web Analytics 的 beacon token
# umami：ANALYTICS_TOKEN = 网站 ID；自建实例再填 ANALYTICS_SCRIPT_URL
ANALYTICS_PROVIDER=
ANALYTICS_TOKEN=
ANALYTICS_SCRIPT_URL=

# 可选：本地后台（pnpm admin）的访问数据，只在本机使用，不要放到 GitHub
# CF_API_TOKEN 权限：Account → Account Analytics → Read
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_SITE_TAG=
