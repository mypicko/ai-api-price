# 复制为 .env 后填写。线上请填到 GitHub → Settings → Secrets and variables → Actions
SITE_URL=http://localhost:4321
BASE_PATH=/

# 飞书群机器人（默认推送渠道）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 可选：Telegram / 邮件
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

NOTIFY_CHANNELS=
NOTIFY_ON_SUCCESS=false
ANOMALY_THRESHOLD=0.8
STALE_ALERT_DAYS=3
STALE_WARN_DAYS=7
FX_FALLBACK_RATE=7.1
SOURCES_ENABLED=
DRY_RUN=false
LOG_LEVEL=info

# 可选：访问统计（不使用 Cookie，公开值，放 GitHub Variables 即可）
# cloudflare：ANALYTICS_TOKEN = Cloudflare Web Analytics 的 beacon token
# umami：ANALYTICS_TOKEN = 网站 ID；自建实例再填 ANALYTICS_SCRIPT_URL
ANALYTICS_PROVIDER=
ANALYTICS_TOKEN=
ANALYTICS_SCRIPT_URL=
