  "volcengine/doubao-seedance-2-0-260128": {
    "litellm_provider": "volcengine",
    "mode": "video_generation",
    "source": "https://www.volcengine.com/docs/82379/1544106",
    "output_cost_per_second": 0.141942857,
    "output_cost_per_second_480p": 0.066003429,
    "output_cost_per_second_720p": 0.141942857,
    "output_cost_per_second_1080p": 0.354085714,
    "output_cost_per_second_4k": 0.722057143,
    "supported_modalities": [
      "text",
      "image",
      "video",
      "audio"
    ],
    "supported_output_modalities": [
      "video"
    ],
    "supported_endpoints": [
      "/v1/videos"
    ],
    "provider_specific_entry": {
      "volcengine_video_frames": {
        "480p": {
          "16:9": "864x496",
          "4:3": "752x560",
          "1:1": "640x640",
          "3:4": "560x752",
          "9:16": "496x864",
          "21:9": "992x432"
        },
        "720p": {
          "16:9": "1280x720",
          "4:3": "1112x834",
          "1:1": "960x960",
          "3:4": "834x1112",
          "9:16": "720x1280",
          "21:9": "1470x630"
        }
      }
    },
    "metadata": {
      "comment": "Ark bills per output token, not per second: tokens = width * height * 24 * seconds / 1024, so a per-second rate per resolution tier is exact for the 16:9 geometry Ark publishes (1280x720 is 21600 tokens/s; the 480p frame is 864x496, 10044 tokens/s, not the tier's nominal 854x480). List 46 CNY per million tokens at 480p and 720p, 51 at 1080p, and 26 at 4k without a video input, matching Ark's per-resolution table and its 1080p and 4k 16:9 examples of 2.48 and 5.05 CNY/s, converted at 7.0 CNY/USD like the other volcengine entries. Clips of 4-15s; 4k is exclusive to this tier. Requests with a video input bill at a lower rate per token and are rejected, since their cost is not known at create time. provider_specific_entry.volcengine_video_frames is the frame Ark renders per resolution tier and ratio, verified with ffprobe at 480p for every ratio and at 720p for 16:9 and 4:3; the other 720p ratios are from the Seedance 2.0 model card."
    }
  },
