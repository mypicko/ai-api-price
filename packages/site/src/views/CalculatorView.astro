---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Calculator } from "../components/Calculator";
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import { getSiteModel } from "../lib/site-data";
import { calcOfferings, fxNote, vendorOptions } from "../lib/views";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const model = getSiteModel();
const offerings = calcOfferings(model, locale);
---

<BaseLayout locale={locale} path="calculator/" title={t(locale, "calc.title")} description={t(locale, "calc.lead")}>
  <div class="flex flex-col gap-8">
    <header class="flex flex-col gap-2">
      <h1 class="text-h1">{t(locale, "calc.title")}</h1>
      <p class="max-w-2xl text-text-muted">{t(locale, "calc.lead")}</p>
    </header>
    <Calculator
      client:load
      offerings={offerings}
      vendors={vendorOptions(model, locale, offerings.map((o) => o.vendor))}
      locale={locale}
      base={import.meta.env.BASE_URL}
      usdCny={model.usdCny}
      fxNote={fxNote(model, locale)}
    />
  </div>
</BaseLayout>
