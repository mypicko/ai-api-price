---
/**
 * 旧的视频/图像页：已并入首页价格榜的「视频」「图像」标签，这里只做跳转，保证旧链接可用。
 */
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import { pageHref } from "../lib/url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const target = `${pageHref(base, locale, "")}?kind=video`;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{t(locale, "media.moved")}</title>
  </head>
  <body>
    <p><a href={target} data-testid="media-moved">{t(locale, "media.moved")}</a></p>
  </body>
</html>
