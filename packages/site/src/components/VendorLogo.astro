---
/** 24×24 厂商标识；没有 logo 时显示首字母圆形占位（STYLE §7.1） */
interface Props {
  name: string;
  logo: string | null;
}
const { name, logo } = Astro.props;
const base = import.meta.env.BASE_URL;
const initial = Array.from(name.trim())[0]?.toUpperCase() ?? "?";
const src = logo ? `${base}${logo.replace(/^\/+/, "")}` : null;
---

{
  src ? (
    <img src={src} alt={name} width="24" height="24" class="size-6 rounded-full" loading="lazy" decoding="async" />
  ) : (
    <span
      aria-hidden="true"
      class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-soft text-micro font-semibold text-accent"
    >
      {initial}
    </span>
  )
}
