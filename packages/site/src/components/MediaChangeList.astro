---
/**
 * 视频/图像的最近变动 + 开放接口链接。显示在「变动」页文本变动的下方（DEV §3.10）。
 */
import { TypeBadge } from "./ChangeBadge";
import { RECENT_CHANGES_DAYS } from "../lib/api";
import { formatDateTime, t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import { getSiteModel } from "../lib/site-data";
import { eventsWithinDays } from "../lib/site-model";
import { joinBase } from "../lib/url";
import { mediaEventViews } from "../lib/views";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const model = getSiteModel();
const events = mediaEventViews(
  model,
  eventsWithinDays(model.media.events, model.generatedAt, RECENT_CHANGES_DAYS),
  locale,
);
---

<div class="flex flex-col gap-3">
<section aria-labelledby="media-changes" class="flex flex-col gap-3">
  <h2 id="media-changes" class="text-h3">{t(locale, "media.changes")}</h2>
  {
    events.length === 0 ? (
      <p class="text-text-muted">{t(locale, "media.changes.empty")}</p>
    ) : (
      <ul class="flex flex-col divide-y divide-border rounded-lg border border-border" data-testid="media-changes">
        {events.map((e) => (
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 text-table">
            <TypeBadge type={e.type} locale={locale} />
            <span class="font-medium">{e.displayName}</span>
            <span class="text-small text-text-muted">{e.vendorName}</span>
            {e.fields.length > 0 && <span class="tabular">{e.fields.join(t(locale, "rss.fieldSeparator"))}</span>}
            {e.confirmedFromQuarantine && <span class="text-small text-text-muted">{t(locale, "change.fromQuarantine")}</span>}
            <time class="ml-auto text-small text-text-muted tabular" datetime={e.detectedAt}>
              {formatDateTime(e.detectedAt, locale)}
            </time>
          </li>
        ))}
      </ul>
    )
  }
</section>
<footer class="flex flex-col gap-2 text-small text-text-muted">
  <p class="max-w-3xl">{t(locale, "media.note")}</p>
  <p class="flex flex-wrap gap-2">
    <a class="btn h-8 font-mono" href={joinBase(base, "api/v1/media.json")}>media.json</a>
    <a class="btn h-8 font-mono" href={joinBase(base, "api/v1/media/changes.json")}>media/changes.json</a>
  </p>
</footer>
</div>
