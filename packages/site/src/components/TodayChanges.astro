---
import { EventItem } from "./EventItem";
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import { getSiteModel } from "../lib/site-data";
import { recentEvents } from "../lib/site-model";
import { pageHref } from "../lib/url";
import { toEventView } from "../lib/views";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const model = getSiteModel();
const { items, total } = recentEvents(model.events, model.generatedAt);
---

<section aria-labelledby="today-changes" class="flex flex-col gap-3" data-testid="today-changes">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="today-changes" class="text-h2">{t(locale, "home.todayChanges.title")}</h2>
    <a href={pageHref(base, locale, "changes/")} class="link text-small">
      {t(locale, "home.todayChanges.viewAll")}{total > items.length ? ` (${total})` : ""} →
    </a>
  </div>
  {
    items.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border px-4 py-6 text-center text-small text-text-muted">
        {t(locale, "home.todayChanges.empty")}
      </p>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((event) => (
          <li>
            <EventItem event={toEventView(model, event, locale)} locale={locale} base={base} variant="card" />
          </li>
        ))}
      </ul>
    )
  }
</section>
