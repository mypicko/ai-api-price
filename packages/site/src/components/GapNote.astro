---
/** 模型详情页：国内官方价 vs OpenRouter 价的一句话说明（DEV §3.17） */
import GapBadge from "./GapBadge.astro";
import type { PriceGap } from "../lib/gap";
import { t } from "../lib/i18n";
import type { Locale } from "../lib/locale";
import { formatPrice } from "../lib/shared-client";
import { getSiteModel } from "../lib/site-data";
import { platformName } from "../lib/site-model";

interface Props {
  locale: Locale;
  gap: PriceGap;
}

const { locale, gap } = Astro.props;
const model = getSiteModel();
const pair = (o: PriceGap["domestic"]): string =>
  `${formatPrice(o.input, o.currency, { locale })} / ${formatPrice(o.output, o.currency, { locale })}`;
---

<p class="flex flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-border bg-surface px-4 py-3 text-table" data-testid="gap-note">
  <span class="font-medium">{t(locale, "gap.title")}</span>
  <span>
    {platformName(model, gap.domestic.platform, locale)} {pair(gap.domestic)}
    <span class="text-text-muted">vs</span>
    OpenRouter {pair(gap.openrouter)}
  </span>
  <GapBadge locale={locale} pct={gap.pct} />
  <span class="text-small text-text-muted">{t(locale, "gap.basis")}</span>
</p>
